# Copy to .env and fill in. Never commit .env.
# Hugging Face read token (free account). You must also accept the Gemma license at
# https://huggingface.co/google/gemma-2-2b-it (and gemma-2-9b-it) with the same account.
HF_TOKEN=
# Optional, only for --judge anthropic (paid). The default judge is a free local model.
ANTHROPIC_API_KEY=
